#!/bin/sh
LOG="/tmp/autostart.log"
# =========================
# Config
# =========================
AUDIO=true
CURSOR="Bibata-Modern-Ice"
SCALE=1.0
DWALL="$HOME/pictures/walls/wall.jpg"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/autostart"
LAST_THEME="$STATE_DIR/last_theme"
LAST_VARIANT="$STATE_DIR/last_variant"
LAST_WALL="$STATE_DIR/last_wall"
WALL_MODE="${WALL_MODE:-fill}"
SWWW_TRANSITION="${SWWW_TRANSITION:-grow}"
SWWW_DURATION="${SWWW_DURATION:-2}"
mkdir -p "$STATE_DIR"
# =========================
# Wayland-safe scaling ENV
# =========================
export XWAYLAND_SCALE="$SCALE"
export GDK_SCALE=1
export GDK_DPI_SCALE=1
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_SCALE_FACTOR="$SCALE"
export QT_FONT_DPI=96
# =========================
# Tunggu Wayland siap
# =========================
timeout=10
while { [ -z "$WAYLAND_DISPLAY" ] || [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; } && [ "$timeout" -gt 0 ]; do
  sleep 0.1
  timeout=$((timeout - 1))
done
sleep 0.3
# =========================
# Kill old processes FIRST
# =========================
for p in flavours mpvpaper swaybg fnott wlsunset cliphist wireplumber pipewire-pulse pipewire xwayland-satellite; do
  pkill -9 "$p" 2>/dev/null &
done
wait
# =========================
# RESTORE THEME DULU (BLOCKING)
# =========================
if [ -s "$LAST_THEME" ]; then
  SCHEME="$(head -n1 "$LAST_THEME")"
  VARIANT="dark"
  [ -s "$LAST_VARIANT" ] && VARIANT="$(head -n1 "$LAST_VARIANT")"
  
  if [ "$VARIANT" = "light" ]; then
    for s in -light -dawn; do
      flavours list | grep -qw "${SCHEME}${s}" && SCHEME="${SCHEME}${s}" && break
    done
  fi
  
  # Apply theme dan TUNGGU selesai
  flavours apply "$SCHEME" >>"$LOG" 2>&1
  
  # Reload GTK settings immediately
  gsettings set org.gnome.desktop.interface gtk-theme "$(grep gtk-theme-name ~/.config/gtk-3.0/settings.ini | cut -d= -f2)" 2>/dev/null &
fi
# =========================
# Env & Agents (PARALLEL)
# =========================
dbus-update-activation-environment --all &
/usr/libexec/polkit-gnome-authentication-agent-1 &
# =========================
# Audio (PARALLEL) - skip kalau sudah jalan via start-comp -p
# =========================
if [ "$AUDIO" = true ]; then
  {
    pgrep -x pipewire >/dev/null || { pipewire & sleep 0.3; }
    pgrep -x wireplumber >/dev/null || wireplumber &
    pgrep -x pipewire-pulse >/dev/null || pipewire-pulse &
  } >>"$LOG" 2>&1 &
fi
# =========================
# Monitor layout (PARALLEL)
# =========================
{
  PRIMARY_OUTPUT="$(wlr-randr 2>/dev/null | awk '/ connected/ {print $1; exit}')"
  if [ -n "$PRIMARY_OUTPUT" ]; then
    wlr-randr \
      --output "$PRIMARY_OUTPUT" \
      --on \
      --pos 0,0 \
      --scale "$SCALE" \
      --transform normal \
      --adaptive-sync enabled
  fi
} >>"$LOG" 2>&1 &
# =========================
# Services ringan (PARALLEL)
# =========================
command -v fnott >/dev/null 2>&1 && fnott &
seat seat0 xcursor_theme "$CURSOR" &
wlsunset -T 6500 -t 5000 -l -6.2 -L 106.8 &
wl-paste --watch cliphist store -max-items 100 &
xwayland-satellite &
exec >>"$LOG" 2>&1
