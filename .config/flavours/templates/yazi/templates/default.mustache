inactive  = { fg = "#{{base05-hex}}", bg = "#{{base01-hex}}" }
sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

[mode]
normal_main = { fg = "#{{base00-hex}}", bg = "#{{base0D-hex}}", bold = true }
normal_alt  = { fg = "#{{base0D-hex}}", bg = "#{{base01-hex}}" }
select_main = { fg = "#{{base00-hex}}", bg = "#{{base0A-hex}}", bold = true }
select_alt  = { fg = "#{{base0A-hex}}", bg = "#{{base01-hex}}" }
