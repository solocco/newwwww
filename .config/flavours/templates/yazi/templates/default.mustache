icon_warn   = ""
icon_error  = ""

[filetype]
rules = [
	{ mime = "image/*", fg = "#{{base0A-hex}}" },
	{ mime = "{audio,video}/*", fg = "#{{base0E-hex}}" },
	{ mime = "inode/empty", fg = "#{{base0C-hex}}" },
	{ url = "*", is = "orphan", fg = "#{{base08-hex}}" },
	{ url = "*/", fg = "#{{base05-hex}}" },
]
