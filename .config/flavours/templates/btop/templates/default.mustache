#Btop {{scheme-name}} theme
#Generated by flavours
# Main background, empty for terminal default
theme[main_bg]=""
# Main text color
theme[main_fg]="#{{base05-hex}}"
# Title color for boxes
theme[title]="#{{base0E-hex}}"
# Highlight color for keyboard shortcuts
theme[hi_fg]="#{{base0D-hex}}"
# Background color of selected item in processes box
theme[selected_bg]="#{{base0D-hex}}"
# Foreground color of selected item in processes box
theme[selected_fg]="#{{base00-hex}}"
# Color of inactive/disabled text
theme[inactive_fg]="#{{base03-hex}}"
# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#{{base0C-hex}}"
# Cpu box outline color
theme[cpu_box]="#{{base0D-hex}}"
# Memory/disks box outline color
theme[mem_box]="#{{base0D-hex}}"
# Net up/down box outline color
theme[net_box]="#{{base0D-hex}}"
# Processes box outline color
theme[proc_box]="#{{base0D-hex}}"
# Box divider line and small boxes line color
theme[div_line]="#{{base02-hex}}"
# Temperature graph colors (start, mid, end)
theme[temp_start]="#{{base0C-hex}}"
theme[temp_mid]="#{{base0A-hex}}"
theme[temp_end]="#{{base08-hex}}"
# CPU graph colors (start, mid, end)
theme[cpu_start]="#{{base0B-hex}}"
theme[cpu_mid]="#{{base0A-hex}}"
theme[cpu_end]="#{{base08-hex}}"
# Mem/Disk free meter
theme[free_start]="#{{base0B-hex}}"
theme[free_mid]="#{{base0C-hex}}"
theme[free_end]="#{{base0D-hex}}"
# Mem/Disk cached meter
theme[cached_start]="#{{base0E-hex}}"
theme[cached_mid]="#{{base09-hex}}"
theme[cached_end]="#{{base08-hex}}"
# Mem/Disk available meter
theme[available_start]="#{{base0D-hex}}"
theme[available_mid]="#{{base0C-hex}}"
theme[available_end]="#{{base0B-hex}}"
# Mem/Disk used meter
theme[used_start]="#{{base08-hex}}"
theme[used_mid]="#{{base09-hex}}"
theme[used_end]="#{{base0A-hex}}"
# Download graph colors
theme[download_start]="#{{base0B-hex}}"
theme[download_mid]="#{{base0E-hex}}"
theme[download_end]="#{{base08-hex}}"
# Upload graph colors
theme[upload_start]="#{{base0C-hex}}"
theme[upload_mid]="#{{base0E-hex}}"
theme[upload_end]="#{{base08-hex}}"
