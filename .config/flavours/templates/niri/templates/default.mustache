// Niri WM Colors Configuration (Generated by flavours)
// Place this at ~/.config/niri/colors.kdl
// Start flavours

layout {
    focus-ring {
        active-color "#{{base0D-hex}}"
        inactive-color "#{{base02-hex}}"
    }
    
    border {
        active-color "#{{base0D-hex}}"
        inactive-color "#{{base02-hex}}"
    }
    
    tab-indicator {
        active-color "#{{base0D-hex}}"
        inactive-color "#{{base02-hex}}"
        urgent-color "#{{base08-hex}}"
    }
}

overview {
    backdrop-color "#{{base00-hex}}"
}

recent-windows {
    highlight {
        active-color "#{{base0D-hex}}ff"
        urgent-color "#{{base08-hex}}ff"
     }
}


// End flavours
