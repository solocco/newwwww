/* 🚀 ROFI APP LAUNCHER - Grid Layout */
/* Inspired by modern app launchers with centered grid */

@import "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/fonts.rasi"

/* ---- Configuration ---- */
configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    icon-theme: "Papirus-Dark";
}

/* ---- Window ---- */
window {
    width: 50%;
    height: 55%;
    border: 1px;
    border-color: @background-alt;
    border-radius: 16px;
    background-color: @background;
    transparency: "real";
}

/* ---- Mainbox ---- */
mainbox {
    enabled: true;
    children: ["inputbar", "listview"];
    spacing: 20px;
    padding: 30px;
    background-color: transparent;
}

/* ---- Inputbar ---- */
inputbar {
    enabled: true;
    padding: 15px;
    border-radius: 12px;
    background-color: @background-alt;
    children: ["entry"];
    spacing: 10px;
}

entry {
    enabled: true;
    placeholder: "Search";
    placeholder-color: @foreground-alt;
    background-color: transparent;
    text-color: @foreground;
}

/* ---- Listview ---- */
listview {
    enabled: true;
    columns: 4;
    lines: 3;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
    dynamic: false;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    spacing: 20px;
    padding: 10px;
    background-color: transparent;
}

/* ---- Elements ---- */
element {
    enabled: true;
    orientation: vertical;
    padding: 20px 15px;
    spacing: 12px;
    border-radius: 12px;
    background-color: @background-alt;
    text-color: @foreground;
    cursor: pointer;
}

element normal.normal {
    background-color: @background-alt;
    text-color: @foreground;
}

element selected.normal {
    background-color: @accent-transparent;
    text-color: @background;
}

element-icon {
    size: 48px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
