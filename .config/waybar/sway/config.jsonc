{
  "name": "main-bar-sway",
  "id": "main-bar-sway",
  "layer": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "position": "bottom",
  "height": 32,
  "spacing": "",
  "margin": "",
  "fixed-center": true,
  "ipc": true,
  "reload_style_on_change": true,

  // ==== Layout: Sway ====
  "modules-left": [
    "custom/menu",
    "clock",
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [],
  "modules-right": [
    "cpu", 
    "cpu#2",
    "memory", 
    "custom/memory",
    "disk", 
    "disk#2",
    "custom/temp-icon",
    "custom/temp",
    "backlight", 
    "backlight#2",
    "wireplumber", 
    "wireplumber#2",
    "network",
    "network#2",
    "bluetooth",
    "bluetooth#2",
    "custom/power",
    "tray"
  ],

  "tray": {
    "icon-size": 18,
    "spacing": 4,
    "padding": "0 2px 0 2px",
    "border-radius": 8
  },

  /* ---- Menu & util (dari stacking) ---- */
  "custom/menu": {
    "format": "<span ></span>",
    "on-click": "fuzzel",
    "tooltip": false
  },
  "custom/flavours": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Theme selector",
    "on-click": "rofi_flavours"
  },
  "custom/qs": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Quick Settings",
    "on-click": "rofi_quicksettings"
  },
  "custom/power": {
    "format": "",
    "on-click": "footx -e -f gum-power",
    "tooltip": false
  },

  /* ---- Updates ---- */
  "custom/updates": {
    "format": "<span size='large'>{icon}</span>",
    "format-icons": ["󰏗","󱧖","󰋙","󱧙","󰏖"],
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar.py",
    "on-click": "~/.local/bin/chckpds.sh",
    "on-click-right": "~/.local/bin/updbar_rst.sh",
    "signal": 9,
    "interval": 30,
    "tooltip": true
  },
  "custom/updates#2": {
    "format": "{0}",
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar.py", 
    "on-click": "~/.local/bin/chckpds.sh",
    "on-click-right": "~/.local/bin/updbar_rst.sh",
    "signal": 9,
    "interval": 30,
    "tooltip": true
  },

  /* ---- Clock ---- */
  "clock": {
    "format": "{:%H:%M %Z}",
    "format-alt": "{:%A, %d %B %Y}",
    "tooltip": false,
    "tooltip-format": "{:%a %d %b}"
  },
  "clock#2": { "format": "{:L%d}", "tooltip": false },

  /* ---- Audio (PipeWire) ---- */
 "wireplumber": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰄜",
      "portable": "󰄜",
      "car": "󰄋",
      "default": ["󰋋", "󰋋", "󰋋"]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },
  "wireplumber#2": {
    "format": "{volume}%",
    "format-muted": "Mute",
    "format-bluetooth": "{volume}%",
    "format-bluetooth-muted": "Mute",
    "format-source": "{volume}%",
    "scroll-step": 5.0,
    "smooth-scrolling-threshold": 1
  },

  /* ---- Network ---- */
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip": true,
    "tooltip-format": "{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "footx -e -f impala"
  },
  "network#2": { "format": "{essid} [{signalStrength}%]", "tooltip": false, "on-click": "footx -e -f impala" },

  /* ---- Bluetooth ---- */
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip": true,
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "footx -f -e bluetui"
  },
  "bluetooth#2": { "format": "{device_alias}", "tooltip": false, "on-click": "footx -e -f bluetui" },

  /* ---- Temperature ---- */
  "temperature": {
    "format": ""
  },

  "custom/temp-icon": {
    "exec": "~/.config/waybar/scripts/temp.sh icon",
    "interval": 2,
    "return-type": "json",
    "format": "{}"
  },

  "custom/temp": {
    "exec": "~/.config/waybar/scripts/temp.sh value",
    "interval": 2,
    "return-type": "json",
    "format": "{}"
  },

  /* ---- Battery ---- */
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "{icon}",
    "tooltip": true,
    "tooltip-format": "{capacity}%",
    "format-icons": ["","","","",""]
  },
  "battery#2": { "format": "{capacity}%", "tooltip": false },

   /* ---- Backlight ---- */
 "backlight": {
    "interval": 2,
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "footx -e -f gum-nl",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1,
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },
  "backlight#2": {
		"interval": 2,
    "format": "{percent}%",
    "smooth-scrolling-threshold": 1,
    "tooltip": false,
    "on-click": "footx -e -f gum-nl"
  },

  /* ---- Stats (dari stacking) ---- */
  "cpu": { "format": "", "tooltip": true, "tooltip-format": "{usage}%" },
  "cpu#2": { "format": "{usage}%", "tooltip": false },

  "memory": { 
    "format": "",
    "tooltip": true, 
    "tooltip-format": "{used}GiB",
    "on-click": "footx -e -f btop"
  },
  // "memory#2": { "format": "{used}GiB", "tooltip": false },
  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory_usage.sh",
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "on-click": "footx -e -f btop"
  },
  "disk": { "format": "", "tooltip": true, "tooltip-format": "{free} free" },
  "disk#2": { "format": "{free}", "tooltip": false },

  /* ---- Workspaces ---- */
  "sway/workspaces": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}",
    "format-icons": {
      "1": "<span>1</span>",
      "2": "<span>2</span>",
      "3": "<span>3</span>",
      "4": "<span>4</span>",
      "5": "<span>5</span>",
      "6": "<span>6</span>",
      "7": "<span>7</span>",
      "8": "<span>8</span>"
    }
  },
  "sway/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 14,
    "max-length": 100,
    "tooltip": false,
    "rewrite": {
      "Firefox Web Browser": "Firefox",
      "mpv Media Player": "mpv",
      "": "Desktop"
    }
  }
}

