{
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "margin-top": 15,
  "fixed-center": true,
  "ipc": true,
  "reload_style_on_change": true,

  // ==== Layout: Floating Style ====
  "modules-left": [
    "custom/menu",
    "clock",
    "ext/workspaces"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "tray",
    "cpu",
    "custom/memory",
    "disk",
    "backlight",
    "wireplumber",
    "bluetooth",
    "network",
    "custom/power"
  ],

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": false
  },
  
  
  /* ---- Menu ---- */
  "custom/menu": {
    "format": "",
    "on-click": "fuzzel",
    "tooltip": true,
    "tooltip-format": "App Launcher"
  },

  /* ---- Power ---- */
  "custom/power": {
    "format": "⏻",
    "on-click": "launch-power",
    "tooltip": true,
    "tooltip-format": "Power Menu"
  },

  /* ---- Updates ---- */
  "custom/updates": {
    "format": "",
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar_icon.py",
    "on-click": "launch-xr",
    "on-click-right": "~/.local/bin/updbar_rst.sh",
    "signal": 9,
    "interval": 300,
    "tooltip": false
  },
  "custom/updates#2": {
    "format": "{text}",
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar_count.py",
    "on-click": "launch-xr",
    "on-click-right": "~/.local/bin/updbar_rst.sh",
    "signal": 9,
    "interval": 300,
    "tooltip": false
  },

  /* ---- Clock (Center) ---- */
  "clock": {
    "format": "{:%H:%M}  ",
    "format-alt": "{:%A, %d %b %y}  ",
    "tooltip": true,
    "tooltip-format": "Clock"
  },

  /* ---- Audio (PipeWire) ---- */
  "wireplumber": {
    "format": "{volume}%  {icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰄜",
      "portable": "󰄜",
      "car": "󰄋",
      "default": ["󰋋", "󰋋", "󰋋"]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume"
  },

  "wireplumber#2": {
    "format": "{volume}%",
    "tooltip": false
  },

  /* ---- Network ---- */
  "network": {
    "interface": "wlp3s0",
    "format": "{ifname}",
    "format-wifi": "{essid}  󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format": "Network",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "footx -f -e impala"
  },

  /* ---- Bluetooth ---- */
  "bluetooth": {
    "format": "{status}  󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "{device_alias}  󰂱",
    "tooltip": true,
    "tooltip-format": "Bluetooth",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "Bluetooth",
    "on-click": "footx -f -e bluetui"
  },

  /* ---- Temperature ---- */
  "custom/temp-icon": {
    "exec": "~/.config/waybar/scripts/temp.sh icon",
    "interval": 3,
    "return-type": "json",
    "format": "{text}"
  },

  /* ---- Battery ---- */
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 Full",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "{timeTo}\n{power}W"
  },

  /* ---- Backlight ---- */
  "backlight": {
    "interval": 2,
    "format": "{percent}%  {icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "launch-nl",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1,
    "tooltip": true,
    "tooltip-format": "Brightness"
  },

    /* ---- CPU ---- */
  "cpu": {
    "interval": 3,
    "format": "{usage}%  {icon}",
    "format-icons": "",
    "tooltip": true,
    "tooltip-format": "CPU Usage:"
  },

  /* ---- Memory ---- */
  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory_usage.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "footx -f -e btop",
    "format":  "{}  " 
  },

  /* ---- Disk ---- */
  "disk": {
    "format": "{free}  󰋊",
    "interval": 30,
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Used: {used}\nFree: {free}\nTotal: {total}"
  },

  /* ---- Workspaces ---- */
  "ext/workspaces": {
    "format": "{name}",
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true
  }
}
