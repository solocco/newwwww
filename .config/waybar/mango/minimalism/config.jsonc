{
  "name": "main-bar",
  "id": "main-bar",
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "height": 26,
  "spacing": 6,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "fixed-center": false,
  "ipc": true,
  "reload_style_on_change": true,

  // ==== Layout: Simple Style ====
  "modules-left": [
    "ext/workspaces",
    "dwl/window"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "custom/updates",
    "custom/updates#2",
    "custom/temp-icon",
    "cpu",
    "custom/memory",
    "disk",
    "backlight",
    "wireplumber",
    "bluetooth",
    "network",
    "clock",
    "custom/power"
  ],

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": false
  },

  /* ---- Power ---- */
  "custom/power": {
    "format": "⏻",
    "on-click": "launch-power",
    "tooltip": false
  },

  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory_usage.sh",
    "interval": 2,
    "return-type": "json",
    "format": "󰍛 {}"
  },

  /* ---- Updates ---- */
  "custom/updates": {
    "format": "",
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar_icon.py",
    "on-click": "launch-xr",
    "on-click-right": "~/.local/bin/updbar_rst.sh",
    "signal": 9,
    "interval": 300,
    "tooltip": false
  },
  "custom/updates#2": {
    "format": "{text}",
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar_count.py",
    "on-click": "launch-xr",
    "on-click-right": "~/.local/bin/updbar_rst.sh",
    "signal": 9,
    "interval": 300,
    "tooltip": false
  },

  /* ---- Clock ---- */
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip": true,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
  },

  /* ---- Audio (PipeWire) ---- */
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰄜",
      "portable": "󰄜",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },

  /* ---- Network ---- */
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format": "{essid} - {signalStrength}%\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "launch-wifi"
  },

  /* ---- Bluetooth ---- */
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "• {device_alias}\t{device_address}",
    "on-click": "launch-bluetooth"
  },

  /* ---- Temperature ---- */
  "custom/temp-icon": {
    "exec": "~/.config/waybar/scripts/temp.sh icon",
    "interval": 3,
    "return-type": "json",
    "format": "{text}"
  },

  /* ---- Battery ---- */
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 Full",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "{timeTo}\n{power}W"
  },

  /* ---- Backlight ---- */
  "backlight": {
    "interval": 2,
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "launch-nl",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1,
    "tooltip": false
  },

  /* ---- CPU ---- */
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "on-click": "kitty -e btop",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%"
  },

  /* ---- Memory ---- */
  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 3,
    "on-click": "kitty -e btop",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
  },

  /* ---- Disk ---- */
  "disk": {
    "format": "󰋊 {percentage_used}%",
    "interval": 30,
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Used: {used}\nFree: {free}\nTotal: {total}"
  },

  /* ---- Workspaces ---- */
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-id": true
  },

  /* ---- Window Title ---- */
  "dwl/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 16,
    "max-length": 60,
    "tooltip": false,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹 $1",
      "(.*) - Google Chrome": " $1",
      "(.*) - Visual Studio Code": "󰨞 $1",
      "(.*)nvim": " $1"
    }
  }
}
