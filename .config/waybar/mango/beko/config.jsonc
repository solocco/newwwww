{
  "layer": "top",
  //"mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "position": "left",
  "height": "",
  "spacing": 0,
  "margin": 0, 					// Space around the bar
  "margin-top": 0, 				// Space above the bar
  "margin-bottom": 0, 			// Space below the bar
  "margin-left": 0, 				// Space to the left of the bar
  "margin-right": 0, 				// Space to the right of the bar
  "fixed-center": true,
  "ipc": true,
  "reload_style_on_change": true,

  // ==== Layout: pakai gaya stacking ====
  "modules-left": [
    "custom/menu",
    "ext/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "cpu", "cpu#2",
    "memory", "memory#2",
    "backlight", "backlight#2",
    "wireplumber", "wireplumber#2",
    "network",
    "bluetooth",
    "clock", "clock#2",
    "custom/power",
    "tray"
  ],


  "tray": {
    "icon-size": 18,
    "spacing": 4,
    "padding": "0 2px 0 2px",
    "border-radius": 8
  },

  /* ---- Menu & util (dari stacking) ---- */
  "custom/menu": {
    "format": "󰌽",
    "on-click": "fuzzel",
    "tooltip": false
  },
  "custom/power": {
    "format": "",
    "on-click": "footx -e -f gum-power",
    "tooltip": false
  },

  // waybar-clock
  "clock": {
    "interval": 60,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H}"
  },
  "clock#2": {
    "interval": 60,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%M}"
  },

  /* ---- Audio: pakai pulseaudio model stacking (PipeWire kompatibel via pipewire-pulse) ---- */
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰄜",
      "portable": "󰄜",
      "car": "󰄋",
      "default": ["󰋋", "󰋋", "󰋋"]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },
  "wireplumber#2": {
    "format": "{volume}%",
    "format-muted": "Mute",
    "format-bluetooth": "{volume}%",
    "format-bluetooth-muted": "Mute",
    "format-source": "{volume}%",
    "scroll-step": 5.0,
        //"on-click": "pulsemixer --toggle-mute",
        //"on-click-right": "pulsemixer --toggle-mute",
        "smooth-scrolling-threshold": 1
  },

  /* ---- Networking (dari stacking; klik buka net-menu) ---- */
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip": true,
    "tooltip-format": "{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "footx -e -f impala"
  },

 // "network#2": { "format": "{signalStrength}%", "tooltip": false, "on-click": "footx -e -f imapala" },

  /* ---- Bluetooth (opsional; tetap disediakan) ---- */
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": "",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "footx -e -f bluetui"
  },
  "bluetooth#2": { "format": "{status}", "tooltip": false },

  /* ---- Battery & Backlight (gabung kebiasaan stacking + kebutuhan laptop) ---- */
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "{icon}",
    "tooltip": true,
    "tooltip-format": "{capacity}%",
    "format-icons": ["","","","",""]
  },
  "battery#2": { "format": "{capacity}%", "tooltip": false },


  // waybar-backlight
  
/* ---- Backlight ---- */
  "backlight": {
    "interval": 2,
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "footx -e -f gum-nl",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1,
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },
  "backlight#2": {
    "interval": 2,
    "format": "{percent}%",
    "tooltip": false,
    "on-click": "footx -e -f gum-nl",
    "smooth-scrolling-threshold": 1
  },

  /* ---- Stats (dari stacking) ---- */
  "cpu": { "format": "", "tooltip": true, "tooltip-format": "{usage}%", "on-click": "footx -e -f btop" },
  "cpu#2": { "format": "{usage}%", "tooltip": false, "on-click": "footx -e -f btop" },

  "memory": { "format": "", "tooltip": true, "tooltip-format": "{percentage}%" },
  "memory#2": { "format": "{percentage}%", "tooltip": false },

  "disk": { "format": "", "tooltip": true, "tooltip-format": "{free} free" },
  "disk#2": { "format": "{free}", "tooltip": false },

  "ext/workspaces": {
    "format": "{name}"
  },  
}
