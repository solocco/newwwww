[
    {
        "layer": "top",
        "position": "left",
        "orientation": "vertical",
        "reload_style_on_change": true,
        "modules-center": ["group/top", "ext/workspaces", "group/bottom"],
        "group/top": {
            "orientation": "inherit",
            "modules": ["clock", "clock#2"]
        },
        "group/bottom1": {
            "orientation": "inherit",
            "modules": ["wlr/taskbar"]
        },
        "group/bottom": {
            "orientation": "inherit",
            "modules": [
                "wlr/taskbar",
                "network",
                "bluetooth",
                "group/battery",
                "tray"
            ]
        },
        "privacy": {
            "icon-spacing": 4,
            "icon-size": 18,
            "transition-duration": 200,
            "modules": [
                {
                    "type": "screenshare",
                    "tooltip": true,
                    "tooltip-icon-size": 24
                },
                {
                    "type": "audio-in",
                    "tooltip": true,
                    "tooltip-icon-size": 24
                }
            ]
        },
        "wlr/taskbar": {
            "icon-size": 20,
            "format": "{icon}",
            "on-click": "activate",
            "tooltip": true,
            "tooltip-format": "{title}",
            "active-first": true
        },
        "ext/workspaces": {
            "format": "{name}",
            "all-outputs": true
        },
        "tray": {
            "icon-size": 21,
            "spacing": 10,
            "icons": {
                "blueman": "bluetooth"
            }
        },
        "network": {
            "format": "{icon}",
            "format-disabled": "\ue1da",
            "format-wifi": "{icon}",
            "format-disconnected": "\uf067",
            "format-ethernet": "\ue8be",
            "format-icons": {
                "wifi": ["\ue4ca", "\ue4d9", "\ue63e"]
            },
            "tooltip-format-wifi": "{essid} ({signalStrength}%)",
            "on-click": "footx -e -f impala"
        },
        "bluetooth": {
            "format-connected": "\ue1a8",
            "format": "\ue1a7",
            "format-off": "\ue1a9",
            "tooltip": "{device_alias}",
            "on-click": "footx -e -f bluetui"
        },
        "bluetooth#battery": {
            "format": "",
            "format-connected-battery": "{device_battery_percentage}",
            "on-click": "footx -e -f bluetui"
        },
        "group/battery": {
            "orientation": "inherit",
            "modules": ["battery#icon", "battery"]
        },
        "battery#icon": {
            "states": {
                "warning": 20,
                "critical": 10
            },
            "full-at": 97,
            "format": "{icon}",
            "format-charging": "\uea0b",
            "format-icons": [
                "\uf30c",
                "\uf30b",
                "\uf30a",
                "\uf309",
                "\uf308",
                "\uf307",
                "\uf304"
            ],
            "interval": 5
        },
        "battery": {
            "states": {
                "warning": 20,
                "critical": 10
            },
            "full-at": 97,
            "format": "{capacity}",
            "interval": 5
        },
        "custom/separator": {
          "format": "\uf108",
          "tooltip": false
        },
        "clock": {
          "interval": 60,
          "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
          "format": "{:%H}"
        },
        "clock#2": {
          "interval": 60,
          "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
          "format": "{:%M}"
        }
    }
]
