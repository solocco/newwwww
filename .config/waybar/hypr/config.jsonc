{
  "name": "main-bar-hyprland",
  "layer": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin": "8 60 8 60",
  "fixed-center": true,
  "ipc": true,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/menu",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [],

  "modules-right": [
    "custom/updates",
    "custom/updates#2",

    "cpu", "cpu#2",
    "memory", "memory#2",
    "disk", "disk#2",

    "backlight", "backlight#2",
    "battery", "battery#2",

    "network",
    "clock",

    "custom/qs",
    "custom/power",
    "tray"
  ],

  /* ================= HYPRLAND ================= */

  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 14,
    "max-length": 50,
    "tooltip": false,
    "rewrite": {
      "Firefox Web Browser": "Firefox",
      "mpv Media Player": "mpv",
      "": "Desktop"
    }
  },

  /* ================= MENU ================= */

  "custom/menu": {
    "format": " ",
    "on-click": "rofi_launcher",
    "tooltip": false
  },

  "custom/qs": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Quick Settings",
    "on-click": "rofi_quicksettings"
  },

  "custom/power": {
    "format": " ",
    "on-click": "powermenu.sh",
    "tooltip": false
  },

  /* ================= UPDATES ================= */

  "custom/updates": {
    "format": "{icon}",
    "format-icons": ["󰏗","󱧖","󰋙","󱧙","󰏖"],
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar.py",
    "interval": 30,
    "signal": 9,
    "tooltip": true,
    "on-click": "~/.local/bin/chckpds.sh",
    "on-click-right": "~/.local/bin/updbar_rst.sh"
  },

  "custom/updates#2": {
    "format": "{0}",
    "return-type": "json",
    "exec": "python3 ~/.local/bin/updbar.py",
    "interval": 30,
    "signal": 9,
    "tooltip": false
  },

  /* ================= CLOCK ================= */

  "clock": {
    "format": "{:L%H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  /* ================= NETWORK ================= */

  "network": {
    "format-wifi": " ",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip": true,
    "tooltip-format": "{ipaddr}",
    "on-click": "net-menu.sh bottom-right"
  },

  /* ================= BATTERY ================= */

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-icons": ["","","","",""],
    "tooltip": true,
    "tooltip-format": "{capacity}%"
  },

  "battery#2": {
    "format": "{capacity}%",
    "tooltip": false
  },

  /* ================= BACKLIGHT ================= */

  "backlight": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "{percent}%"
  },

  "backlight#2": {
    "format": "{percent}%",
    "tooltip": false
  },

  /* ================= STATS ================= */

  "cpu": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "{usage}%"
  },

  "cpu#2": {
    "format": "{usage}%",
    "tooltip": false
  },

  "memory": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "{percentage}%"
  },

  "memory#2": {
    "format": "{percentage}%",
    "tooltip": false
  },

  "disk": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "{free} free"
  },

  "disk#2": {
    "format": "{free}",
    "tooltip": false
  },

  /* ================= TRAY ================= */

  "tray": {
    "icon-size": 18,
    "spacing": 4
  }
}
