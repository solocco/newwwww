input {
  keyboard {
    xkb {
      layout "us,fr"
      options "grp:rctrl_rshift_toggle,numpad:mac,compose:ralt"
    }
  }

  touchpad {
    tap
    //natural-scroll
    accel-speed 0.2
    accel-profile "adaptive"
    scroll-method "two-finger"
  }

  mouse {
    accel-profile "flat"
  }

  trackpoint {
    off
  }

  touch {
    map-to-output "DP-2"
  }

  tablet {
    map-to-output "DP-2"
  }
}

