// Niri WM Colors Configuration (Generated by flavours)
// Place this at ~/.config/niri/colors.kdl
// Start flavours

layout {
    focus-ring {
        active-color "#7fbbb3"
        inactive-color "#3c3f4c"
    }
    
    border {
        active-color "#7fbbb3"
        inactive-color "#3c3f4c"
    }
    
    tab-indicator {
        active-color "#7fbbb3"
        inactive-color "#3c3f4c"
        urgent-color "#e67e80"
    }
}

overview {
    backdrop-color "#1d2021"
}

recent-windows {
    highlight {
        active-color "#7fbbb3ff"
        urgent-color "#e67e80ff"
     }
}


// End flavours