// Niri WM Colors Configuration (Generated by flavours)
// Place this at ~/.config/niri/colors.kdl
// Start flavours

layout {
    focus-ring {
        active-color "#83a598"
        inactive-color "#504945"
    }
    
    border {
        active-color "#83a598"
        inactive-color "#504945"
    }
    
    tab-indicator {
        active-color "#83a598"
        inactive-color "#504945"
        urgent-color "#fb4934"
    }
}

overview {
    backdrop-color "#282828"
}

recent-windows {
    highlight {
        active-color "#83a598ff"
        urgent-color "#fb4934ff"
     }
}


// End flavours