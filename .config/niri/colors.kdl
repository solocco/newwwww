// Niri WM Colors Configuration (Generated by flavours)
// Place this at ~/.config/niri/colors.kdl
// Start flavours

layout {
    focus-ring {
        active-color "#7e9cd8"
        inactive-color "#363646"
    }
    
    border {
        active-color "#7e9cd8"
        inactive-color "#363646"
    }
    
    tab-indicator {
        active-color "#7e9cd8"
        inactive-color "#363646"
        urgent-color "#c34043"
    }
}

overview {
    backdrop-color "#1f1f28"
}

recent-windows {
    highlight {
        active-color "#7e9cd8ff"
        urgent-color "#c34043ff"
     }
}


// End flavours