// Niri WM Colors Configuration (Generated by flavours)
// Place this at ~/.config/niri/colors.kdl
// Start flavours

layout {
    focus-ring {
        active-color "#edb95a"
        inactive-color "#706a6a"
    }
    
    border {
        active-color "#edb95a"
        inactive-color "#706a6a"
    }
    
    tab-indicator {
        active-color "#edb95a"
        inactive-color "#706a6a"
        urgent-color "#e25d6c"
    }
}

overview {
    backdrop-color "#0f0f0f"
}

recent-windows {
    highlight {
        active-color "#edb95aff"
        urgent-color "#e25d6cff"
     }
}


// End flavours