layout {
  gaps 3.5
  background-color "transparent"
  center-focused-column "never"
  always-center-single-column
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }
  default-column-width {}
  focus-ring {
    off
    width 1.5
  }
  border {
    on
    width 2
  }
  struts {
    // left 64
    // right 64
    // top 64
    // bottom 64
  }
  tab-indicator {
    hide-when-single-tab
    place-within-column
    gap 2
    width 8
    length total-proportion=0.5
    position "left"
    gaps-between-tabs 8
    corner-radius 5
  }
}

cursor {
  hide-when-typing
  xcursor-theme "Bibata-Modern-Ice"
  xcursor-size 24
}

overview {
  zoom 0.50
  workspace-shadow {
        off
    }
}

hotkey-overlay {
  skip-at-startup
}

recent-windows {
  debounce-ms 750

  open-delay-ms 150

  highlight {
    padding 30
    corner-radius 8
  }

  previews {
    max-height 480
    max-scale 0.5
  }
}


