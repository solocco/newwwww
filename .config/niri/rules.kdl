window-rule {
  geometry-corner-radius 8
  clip-to-geometry true
  draw-border-with-background false
}

window-rule {
  match app-id="alacritty"
  default-column-width { proportion 0.5; }
}

window-rule {
  match app-id="LibreWolf"
  match app-id="pcmanfm-qt"
  match app-id="com.chatterino.chatterino"
  match app-id="google-chrome"
  match app-id="brave-browser"
}

window-rule {
  match app-id="firefox$" title="^Picture-in-Picture$"
  open-floating true
  default-floating-position x=16 y=16 relative-to="bottom-left"
}

window-rule {
  match app-id="foot-float"
  match title="gum-xr"
  match app-id="blueman-manager"
  match app-id="pulseaudio-equalizer-gtk"
  open-floating true
}

window-rule {
  match app-id="pavucontrol$"
  open-floating true
  default-floating-position x=4 y=4 relative-to="bottom-right"
}

layer-rule {
    match namespace="swww-daemon"
    place-within-backdrop true
}

