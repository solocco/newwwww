#!/usr/bin/env bash
set -euo pipefail
# ---------------------------------------------------------
# Deps
# ---------------------------------------------------------
need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[!] missing dependency: $1"
    exit 1
  }
}
need gum
need xr
need sudo

# ---------------------------------------------------------
# Get terminal emulator
# ---------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TERMINAL=$("$SCRIPT_DIR/get-terminal")

run_in_terminal() {
  local cmd="$1"
  # Minimize main window dulu
  mmsg -d minimized
  sleep 0.2
  # Buka terminal floating
  $TERMINAL --class="$TERMINAL-float" -e bash -c "$cmd; read -p 'Press enter to close...'"
  # Restore main window
  mmsg -d restore_minimized
}

# ---------------------------------------------------------
# xbps-src submenu (xr -l)
# ---------------------------------------------------------
xr_xbps_menu() {
  [ -d "$HOME/void-packages" ] || {
    gum style --foreground 196 "void-packages not found in \$HOME"
    return 1
  }
  cd "$HOME/void-packages"
  
  while true; do
    ACTION=$(gum choose \
      "󰆍  build package" \
      "󰃢  clean package" \
      "󰈔  new template" \
      "󰏫  edit template" \
      "󰘦  checksum package" \
      "󰏗  install package" \
      "󰏗󰖟 install nonfree package" \
      "󰅁  back"
    ) || return 0
    
    case "$ACTION" in
      "󰆍"*)
        PKG=$(gum input --prompt "󰆍 build > ")
        [ -n "$PKG" ] && run_in_terminal "xr -l build $PKG"
        ;;
      "󰃢"*)
        PKG=$(gum input --prompt "󰃢 clean > ")
        [ -n "$PKG" ] && run_in_terminal "xr -l clean $PKG"
        ;;
      "󰈔"*)
        PKG=$(gum input --prompt "󰈔 new > ")
        [ -n "$PKG" ] && run_in_terminal "xr -l new $PKG nvim"
        ;;
      "󰏫"*)
        PKG=$(gum input --prompt "󰏫 edit > ")
        [ -n "$PKG" ] && run_in_terminal "xr -l edit $PKG nvim"
        ;;
      "󰘦"*)
        PKG=$(gum input --prompt "󰘦 checksum > ")
        [ -n "$PKG" ] && run_in_terminal "xr -l checksum $PKG"
        ;;
      "󰏗󰖟"*)
        PKG=$(gum input --prompt "󰏗 nonfree > ")
        [ -n "$PKG" ] && run_in_terminal "sudo xr -l install-nonfree $PKG"
        ;;
      "󰏗"*)
        PKG=$(gum input --prompt "󰏗 install > ")
        [ -n "$PKG" ] && run_in_terminal "sudo xr -l install $PKG"
        ;;
      "󰅁"*)
        return 0
        ;;
    esac
  done
}
# ---------------------------------------------------------
# Change mirror menu
# ---------------------------------------------------------
mirror_menu() {
  gum style --foreground 33 "Opening xmirror..."
  sudo xmirror
}
# ---------------------------------------------------------
# fzf interactive mode
# ---------------------------------------------------------
fzf_mode() {
  gum style --foreground 33 "Entering fzf interactive mode..."
  if command -v fzf >/dev/null 2>&1; then
    sudo xr -t || gum style --foreground 196 "󰜺 fzf mode error"
  else
    gum style --foreground 196 "󰜺 fzf not installed"
  fi
}
# ---------------------------------------------------------
# Update system with feedback
# ---------------------------------------------------------
update_system() {
  gum style --foreground 33 "󰚰 Running update..."
  sudo xr -u
  if [ $? -eq 0 ]; then
    notify-send -u normal "󰚰 System Updated" "Your system is up to date!"
    gum style --foreground 82 "󰚰 System updated successfully!"
  else
    notify-send -u critical "󰚰 Update Failed" "Error during system update"
    gum style --foreground 196 "󰚰 Update failed!"
  fi
}
# ---------------------------------------------------------
# Clean unused packages
# ---------------------------------------------------------
clean_packages() {
  gum style --foreground 33 "󰃢 Running cleanup..."
  sudo xr -c
  if [ $? -eq 0 ]; then
    notify-send -u normal "󰃢 Cleanup Complete" "Unused packages removed!"
    gum style --foreground 82 "󰃢 Cleanup completed!"
  else
    notify-send -u critical "󰃢 Cleanup Failed" "Error during cleanup"
    gum style --foreground 196 "󰃢 Cleanup failed!"
  fi
}
# ---------------------------------------------------------
# Manage old kernels
# ---------------------------------------------------------
manage_kernels() {
  gum spin --spinner dot --title "󰌽 Managing old kernels..." -- sudo xr -k
  if [ $? -eq 0 ]; then
    notify-send -u normal "󰌽 Kernel Management" "Old kernels cleaned!"
    gum style --foreground 82 "󰌽 Old kernels removed!"
  else
    notify-send -u normal "󰌽 Kernel Management" "No old kernels to remove"
    gum style --foreground 33 "󰌽 No old kernels to remove"
  fi
}
# ---------------------------------------------------------
# Main menu
# ---------------------------------------------------------
main_menu() {
  gum choose \
    --header "Void Package Manager" \
    "󰏗  Install package" \
    "󰆴  Remove package" \
    "󰚰  Update system" \
    "󰃢  Clean unused packages" \
    "󰌽  Manage old kernels" \
    "󰆍  Build package (xbps-src)" \
    "󰖟  Change mirror" \
    "󰜺  xr fzf mode" \
    "󰈆  Exit"
}
# ---------------------------------------------------------
# Loop
# ---------------------------------------------------------
while true; do
  CHOICE=$(main_menu) || exit 0
  case "$CHOICE" in
    "󰏗"*)
      PKG=$(gum input --prompt "󰏗 install > ")
      if [ -n "$PKG" ]; then
        run_in_terminal "sudo xr -i $PKG"
      fi
      ;;
    "󰆴"*)
      PKG=$(gum input --prompt "󰆴 remove > ")
      if [ -n "$PKG" ]; then
        run_in_terminal "sudo xr -r $PKG"
      fi
      ;;
    "󰚰"*)
      run_in_terminal "sudo xr -u"
      ;;
    "󰃢"*)
      run_in_terminal "sudo xr -c"
      ;;
    "󰌽"*)
      run_in_terminal "sudo xr -k"
      ;;
    "󰆍"*)
      xr_xbps_menu
      ;;
    "󰖟"*)
      run_in_terminal "sudo xmirror"
      ;;
    "󰜺"*)
      run_in_terminal "sudo xr -t"
      ;;
    "󰈆"*)
      exit 0
      ;;
  esac
done
