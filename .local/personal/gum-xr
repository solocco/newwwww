#!/usr/bin/env bash
set -euo pipefail
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export XDG_CURRENT_DESKTOP=mango
export WAYLAND_DISPLAY=wayland-0
export GUM_INPUT_SHOW_HELP=false
# ---------------------------------------------------------
# Deps
# ---------------------------------------------------------
need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[!] missing dependency: $1"
    exit 1
  }
}
need gum
need xr
need sudo
# ---------------------------------------------------------
# Get terminal emulator
# ---------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TERMINAL=$("$SCRIPT_DIR/get-terminal")
run_in_terminal() {
  local cmd="$1"
  mmsg -d minimized || true
  sleep 0.2
  foot --app-id="foot-float" -e bash -c "$cmd; read -p 'Press enter to close...'"
  mmsg -d restore_minimized || true
}
# ---------------------------------------------------------
# Update system
# ---------------------------------------------------------
update_system() {
  run_in_terminal "sudo xr -u"
}
# ---------------------------------------------------------
# xbps-src submenu (xr -l)
# ---------------------------------------------------------
xr_xbps_menu() {
  [ -d "$HOME/void-packages" ] || {
    gum style --foreground 196 "void-packages not found in \$HOME"
    return 1
  }
  cd "$HOME/void-packages"
  while true; do
    ACTION=$(gum choose \
      "󰆍 build package" \
      "󰃢 clean package" \
      "󰈔 new template" \
      "󰏫 edit template" \
      "󰘦 checksum package" \
      "󰏗 install package" \
      "󰏗󰖟 install nonfree package" \
      "󰅁 back" \
    ) || return 0
    case "$ACTION" in
      "󰆍"*) 
        PKG=$(gum input --prompt "󰆍 build > " --placeholder="package name" || true)
        [ -n "$PKG" ] && run_in_terminal "xr -l build $PKG"
        ;;
      "󰃢"*) 
        PKG=$(gum input --prompt "󰃢 clean > " --placeholder="package name" || true)
        [ -n "$PKG" ] && run_in_terminal "xr -l clean $PKG"
        ;;
      "󰈔"*) 
        PKG=$(gum input --prompt "󰈔 new > " --placeholder="package name" || true)
        [ -n "$PKG" ] && run_in_terminal "xr -l new $PKG nvim"
        ;;
      "󰏫"*) 
        PKG=$(gum input --prompt "󰏫 edit > " --placeholder="package name" || true)
        [ -n "$PKG" ] && run_in_terminal "xr -l edit $PKG nvim"
        ;;
      "󰘦"*) 
        PKG=$(gum input --prompt "󰘦 checksum > " --placeholder="package name" || true)
        [ -n "$PKG" ] && run_in_terminal "xr -l checksum $PKG"
        ;;
      "󰏗󰖟"*) 
        PKG=$(gum input --prompt "󰏗 nonfree > " --placeholder="package name" || true)
        [ -n "$PKG" ] && run_in_terminal "sudo xr -l install-nonfree $PKG"
        ;;
      "󰏗"*) 
        PKG=$(gum input --prompt "󰏗 install > " --placeholder="package name" || true)
        [ -n "$PKG" ] && run_in_terminal "sudo xr -l install $PKG"
        ;;
      "󰅁"*) return 0 ;;
    esac
  done
}
# ---------------------------------------------------------
# Change mirror menu
# ---------------------------------------------------------
mirror_menu() {
  gum style --foreground 33 "Opening xmirror..."
  sudo xmirror
}
# ---------------------------------------------------------
# fzf interactive mode
# ---------------------------------------------------------
fzf_mode() {
  gum style --foreground 33 "Entering fzf interactive mode..."
  if command -v fzf >/dev/null 2>&1; then
    sudo xr -t || gum style --foreground 196 "󰜺 fzf mode error"
  else
    gum style --foreground 196 "󰜺 fzf not installed"
  fi
}
# ---------------------------------------------------------
# Clean unused packages
# ---------------------------------------------------------
clean_packages() {
  gum style --foreground 33 "󰃢 Running cleanup..."
  sudo xr -c
  if [ $? -eq 0 ]; then
    notify-send -u normal "󰃢 Cleanup Complete" "Unused packages removed!"
    gum style --foreground 82 "󰃢 Cleanup completed!"
  else
    notify-send -u critical "󰃢 Cleanup Failed" "Error during cleanup"
    gum style --foreground 196 "󰃢 Cleanup failed!"
  fi
}
# ---------------------------------------------------------
# Manage old kernels
# ---------------------------------------------------------
manage_kernels() {
  while true; do
    ACTION=$(gum choose \
      "󰋚 List old kernels" \
      "󰆴 Remove old kernel" \
      "󰅁 Back" \
    ) || return 0
    
    case "$ACTION" in
      "󰋚"*)
        run_in_terminal "sudo xr -k list"
        ;;
      "󰆴"*)
        VERSION=$(gum input --prompt "󰆴 kernel version > " --placeholder="e.g., 6.1.0_1" || true)
        [ -n "$VERSION" ] && run_in_terminal "sudo xr -k remove $VERSION"
        ;;
      "󰅁"*) return 0 ;;
    esac
  done
}
# ---------------------------------------------------------
# Main menu
# ---------------------------------------------------------
main_menu() {
  gum choose \
    --header "Void Package Manager" \
    "󰏗 Install package" \
    "󰆴 Remove package" \
    "󰚰 Update system" \
    "󰃢 Clean unused packages" \
    "󰌽 Manage old kernels" \
    "󰆍 Build package (xbps-src)" \
    "󰖟 Change mirror" \
    "󰜺 xr fzf mode" \
    "󰈆 Exit"
}
# ---------------------------------------------------------
# Loop
# ---------------------------------------------------------
while true; do
  CHOICE=$(main_menu) || exit 0
  case "$CHOICE" in
    "󰏗"*) 
      PKG=$(gum input --prompt "󰏗 install > " --placeholder="package name" || true)
      [ -n "$PKG" ] && run_in_terminal "sudo xr -i $PKG"
      ;;
    "󰆴"*) 
      PKG=$(gum input --prompt "󰆴 remove > " --placeholder="package name" || true)
      [ -n "$PKG" ] && run_in_terminal "sudo xr -r $PKG"
      ;;
    "󰚰"*) update_system ;;
    "󰃢"*) run_in_terminal "sudo xr -c" ;;
    "󰌽"*) manage_kernels ;;
    "󰆍"*) xr_xbps_menu ;;
    "󰖟"*) run_in_terminal "sudo xmirror" ;;
    "󰜺"*) run_in_terminal "sudo xr -t" ;;
    "󰈆"*) exit 0 ;;
  esac
done
