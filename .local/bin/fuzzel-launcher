#!/usr/bin/env bash

# Path ke config fuzzel-launcher.ini
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel"
CONFIG_FILE="$CONFIG_DIR/fuzzel-launcher.ini"

# Cek apakah config file ada
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: Config file tidak ditemukan di $CONFIG_FILE"
    exit 1
fi

# Launch fuzzel dengan config custom
fuzzel --config="$CONFIG_FILE"
